# ─── 运行环境 ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# API/Worker readiness requires this schema version before the release is considered ready.
REQUIRED_MIGRATION_VERSION=63

# ─── 身份认证 ─────────────────────────────────────────────────────
# 默认保持 Authing。切换 Logto 或其他标准 OIDC 服务前，先在隔离环境完成 PoC。
AUTH_PROVIDER=authing

# ─── Authing 鉴权（AUTH_PROVIDER=authing 时使用）──────────────────
# 在 Authing 控制台「应用」→「应用配置」中获取
AUTHING_APP_ID=your_authing_app_id
# 格式：https://your-app.authing.cn （末尾不带斜杠）
AUTHING_APP_HOST=https://your-app.authing.cn
# 仅本地开发且明确需要 X-Dev-User-Id 时才设为 true；生产必须保持 false。
ALLOW_DEV_AUTH_HEADERS=false
# 唯一 root 管理员的稳定 StarDraw user ID。迁移前可暂时使用旧 Authing JWT sub；
# 角色以数据库为准，JWT 中的 admin/role claim 不参与授权。
ROOT_ADMIN_USER_ID=replace_with_fixed_authing_user_id

# 身份迁移映射。保持 false，直到迁移 058 已在维护窗口应用并完成人工映射。
IDENTITY_LINKS_ENABLED=false

# ─── 标准 OIDC / Logto（AUTH_PROVIDER=oidc 或 logto 时使用）───────
# 发行方地址必须与 access token 的 iss 完全一致（不要随意追加路径）。
OIDC_ISSUER=https://your-oidc.example.com/oidc
# Web 应用的 audience/client id；服务端必须显式校验。
OIDC_AUDIENCE=your_oidc_client_id
# 从 OIDC discovery 返回的 jwks_uri 填写，生产环境必须显式配置。
OIDC_JWKS_URI=https://your-oidc.example.com/oidc/jwks
OIDC_ALGORITHMS=RS256
OIDC_ACCOUNT_API_URL=https://your-oidc.example.com/api

# 邮箱策略由 StarDraw 服务端最终执行；逗号分隔，支持 example.com 与 *.example.com。
# 留空表示不限制后缀；禁止域名优先于允许域名。
AUTH_EMAIL_DOMAIN_ALLOWLIST=
AUTH_EMAIL_DOMAIN_BLOCKLIST=
# 开启后，未完成邮箱验证的身份不能访问 StarDraw 受保护 API。
AUTH_REQUIRE_VERIFIED_EMAIL=true

# ─── 数据库（阿里云 ApsaraDB RDS for PostgreSQL）─────────────────
# 格式：postgres://user:password@host:5432/dbname
# 内网访问（VPC 内推荐）：postgres://user:pass@rm-xxx.pg.rds.aliyuncs.com:5432/stardraw
DATABASE_URL=postgres://user:password@your-rds-host:5432/stardraw

# 是否关闭 SSL（内网 VPC 访问可设为 false；公网访问保留默认 true）
# DB_SSL=false

# ─── 阿里云 OSS ────────────────────────────────────────────────────
OSS_REGION=oss-cn-hangzhou
# 内网端点（ECS 同区推荐，节省流量费）：oss-cn-hangzhou-internal.aliyuncs.com
# 公网端点：oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
# 私有资源短期授权签名密钥，必须独立于 OSS AccessKey，至少 32 字符。
# 示例生成方式：openssl rand -base64 48（不要把真实结果提交到 Git）
RESOURCE_ACCESS_SECRET=replace_with_an_independent_random_secret_at_least_32_chars
# CDN 或公网访问域名（可选，不填则自动拼接 bucket+endpoint）
# OSS_BASE_URL=https://cdn.your-domain.com
# Provider 返回的临时媒体下载域名白名单；生产环境不能为空。支持 *.example.com。
# 同时会自动加入 IMAGE_PROVIDER_BASE_URL、SORA_BASE_URL、HEYGEN_BASE_URL 的主机名。
REMOTE_ASSET_ALLOWED_HOSTS=vip.edu888.top,newapi.zexitongxue.com,oss.aimh8.com,aoss.aimh8.com
REMOTE_ASSET_MAX_BYTES=536870912
REMOTE_ASSET_TIMEOUT_MS=120000
REMOTE_ASSET_MAX_REDIRECTS=3

# ─── 图片 Provider（Mirrmart / 异步图片任务接口）───────────────────
# 图片和视频使用同一个 Mirrmart 账号；IMAGE_PROVIDER_KEY 应填写与 SORA_API_KEY 相同的值。
IMAGE_PROVIDER_KEY=your_sora_api_key
IMAGE_PROVIDER_BASE_URL=https://www.aimh8.com/agent/openapi/fpbrowser2api
IMAGE_PROVIDER_MODEL=gpt-image-2
IMAGE_PROVIDER_FALLBACK_MODEL=gpt-image-2
# 产品逻辑模型仍由数据库 model_catalog 命名；gpt-image-2 会按尺寸映射到
# Mirrmart 的 gpt-image2-1k / gpt-image2-2k / gpt-image2-4k。
IMAGE_PROVIDER_MODELS=gpt-image-2
# 仅填写供应商已确认支持参考图的产品模型。
IMAGE_PROVIDER_REFERENCE_IMAGE_MODELS=gpt-image-2
# 提交任务后轮询任务结果；总超时必须低于前端反向代理的读取超时。
IMAGE_PROVIDER_TIMEOUT_MS=240000
IMAGE_PROVIDER_POLL_INTERVAL_MS=2000
# 图片供应商任务由独立 Worker 轮询，API 不再等待最终图片。
IMAGE_STATUS_RECONCILIATION_ENABLED=true
IMAGE_STATUS_RECONCILIATION_INTERVAL_MS=5000
IMAGE_STATUS_RECONCILIATION_LIMIT=25
PRIVATE_TEMPLATE_IMAGE_POINTS=18
PRIVATE_TEMPLATE_VIDEO_POINTS=150

# ─── Creative LLM（全局/画布 Agent、脚本与图片/视频提示词优化）────────────
CREATIVE_LLM_API_KEY=your_creative_llm_provider_key
CREATIVE_LLM_BASE_URL=https://api.ranai.cc.cd/v1
CREATIVE_LLM_MODEL_KEY=gpt-5.6-sol
CREATIVE_LLM_REASONING_EFFORT=medium
# Canvas Agent uses the same server-side Creative LLM credentials by default.
# The model choices are managed by model_catalog/model_routes migration 055.
# CANVAS_AGENT_LLM_BASE_URL=https://api.ranai.cc.cd/v1
# CANVAS_AGENT_LLM_API_KEY=your_ranai_api_key
AGENT_MEDIA_POLL_INTERVAL_MS=15000
# 兼容回退变量；优先使用 CREATIVE_LLM_*。
# CANVAS_AGENT_KEY=your_ranai_api_key
# CANVAS_AGENT_BASE_URL=https://api.ranai.cc.cd/v1
# CANVAS_AGENT_MODEL=gpt-5.6-sol
# Agent 请求可能包含较多工具 schema；默认给上游 120 秒完成规划。
AGENT_PROVIDER_TIMEOUT_MS=120000
# Canvas Agent 的上下文窗口保护。应按供应商对当前模型公布的上下文上限调整；
# 代码会在该窗口内自动扣除输入上下文和安全余量，再应用阶段性输出预算。
CANVAS_AGENT_CONTEXT_WINDOW_TOKENS=32768
# 初次请求失败后最多重试 5 次（总计最多 6 次）；仅重试无业务副作用的规划请求。
AGENT_PROVIDER_MAX_ATTEMPTS=6
AGENT_PROVIDER_RETRY_DELAY_MS=750
# 网络或代理重放同一规划请求时，等待原操作完成并复用结果，不重复调用模型或扣积分。
AGENT_IDEMPOTENCY_WAIT_MS=180000
AGENT_IDEMPOTENCY_POLL_MS=250

# ─── 视频 Provider（Mirrmart / Veo 兼容接口）──────────────────────
SORA_API_KEY=your_sora_api_key
SORA_BASE_URL=https://www.aimh8.com/agent/openapi/fpbrowser2api
VIDEO_MODEL=veo-3-1

# ─── 数字人视频 Provider（HeyGen Video Agent）──────────────────
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_VIDEO_AGENT_MODEL=video-agent
DIGITAL_HUMAN_OFFLINE_RENDER=false
DIGITAL_HUMAN_OFFLINE_RENDER_DELAY_MS=14000

# 仅供本地开发显式启用供应商 mock；生产环境即使设为 true 也会强制关闭
PROVIDER_MOCKS_ENABLED=false

# ─── PostgreSQL durable workflow worker ───────────────────────────
# Keep false in the API container. Enable only in a separate worker process
# after migrations 025-027 have been reviewed and applied in a maintenance window.
JOB_WORKER_ENABLED=false
JOB_QUEUE_NAME=workflow
JOB_WORKER_POLL_MS=1000
JOB_WORKER_LEASE_MS=60000
JOB_WORKER_RETRY_MS=1000
# Canvas Agent has its own durable queue and Worker. Keep the queue name
# distinct from global Agent/workflow jobs so independent runs cannot block
# or mutate each other's state.
CANVAS_AGENT_JOB_QUEUE_NAME=canvas_agent
CANVAS_AGENT_WORKER_POLL_MS=1000
CANVAS_AGENT_WORKER_LEASE_MS=60000
CANVAS_AGENT_WORKER_RETRY_MS=1000
CANVAS_AGENT_MEDIA_POLL_MS=5000
# Queue insert and active_job_id attachment are separate writes. These small
# delays prevent a worker from leasing a freshly-created run too early.
CANVAS_AGENT_INITIAL_JOB_DELAY_MS=750
CANVAS_AGENT_APPROVAL_JOB_DELAY_MS=750
# Worker process heartbeat. Docker checks this file without opening an HTTP
# port. Keep stale time comfortably above interval plus healthcheck timeout.
WORKER_HEALTH_FILE=/app/tmp/worker-health.json
WORKER_HEALTH_INTERVAL_MS=15000
WORKER_HEALTH_STALE_MS=60000
# Requires migration 031. Keep false until the worker has been tested against
# the target database; it only retries settlements with a durable provider result.
METERED_SETTLEMENT_RECONCILIATION_ENABLED=false
METERED_SETTLEMENT_RECONCILIATION_INTERVAL_MS=60000
METERED_SETTLEMENT_RECONCILIATION_AGE_MS=60000
METERED_SETTLEMENT_RECONCILIATION_LIMIT=50
METERED_SETTLEMENT_ALERT_AFTER_ATTEMPTS=3

# ─── Shared Agent/MCP/workflow admission control ─────────────────
# Global API window and short burst guards. The burst values are intentionally
# high enough for recording/rapid UI interaction, while Nginx adds a separate
# per-client ingress ceiling before requests reach Node/PostgreSQL.
HTTP_GLOBAL_RATE_LIMIT_MAX=5000
OPERATION_RATE_LIMIT_MAX=5000
GENERATION_BURST_LIMIT_MAX=5000
AGENT_BURST_LIMIT_MAX=5000
WORKFLOW_BURST_LIMIT_MAX=5000
AGENT_APPROVAL_BURST_LIMIT_MAX=5000
WORKFLOW_LOOP_MAX_CONCURRENCY=100
COMMUNITY_READ_RATE_LIMIT_MAX=180
MEDIA_PROXY_RATE_LIMIT_MAX=3000

# Keep false until migration 029 is reviewed and applied in the target
# database. The enabled adapter is PostgreSQL-backed and safe for multiple API
# instances; it is not an in-process limiter.
EXECUTION_GOVERNOR_ENABLED=false

# PostgreSQL TLS: private Docker network may set DB_SSL=false. For cloud/RDS,
# keep DB_SSL=true and DB_SSL_VERIFY=true; put the PEM chain in DB_SSL_CA only
# when the provider does not use a public CA.
DB_SSL=false
DB_SSL_VERIFY=true
DB_SSL_CA=

# Root-only filesystem Skills. Each configured skill is a server-side
# directory containing SKILL.md; users cannot upload or edit these files.
AGENT_SKILL_ROOT=/app/skills

# ─── MCP OAuth / Streamable HTTP ──────────────────────────────────
# 生成 32 字节随机主密钥：openssl rand -base64 32
# 只放服务端 Secret，不要提交到仓库；数据库只保存 AES-256-GCM 密文。
MCP_CREDENTIAL_MASTER_KEY=replace_with_32_byte_base64_secret
# 必须与 OAuth provider 后台登记的回调地址完全一致。
MCP_OAUTH_REDIRECT_URI=https://your-domain.com/api/public/mcp/oauth/callback
# OAuth 完成后由服务端固定跳转，禁止使用 provider 返回的 URL。
MCP_OAUTH_SUCCESS_REDIRECT=https://your-domain.com/ai/account
MCP_OAUTH_ERROR_REDIRECT=https://your-domain.com/ai/account
MCP_PROTOCOL_VERSION=2025-06-18
MCP_HTTP_TIMEOUT_MS=15000
MCP_MAX_RESPONSE_BYTES=524288

# ─── 支付宝计费：会员订阅 + 永久积分包 ─────────────────────────────
# 完成数据库迁移、支付宝沙箱验收和密钥轮换后，才改为 true；该开关同时开放两类商品。
SUBSCRIPTION_PURCHASES_ENABLED=false
# 沙箱网关：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式网关：https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_SELLER_ID=your_alipay_seller_id
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/public/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/ai/billing
# 当前未接入支付宝新版商家扣款，必须保持关闭。
ALIPAY_PERIODIC_ENABLED=false
# 旧版兼容字段，不要填写 GENERAL_WITHHOLDING 或 CYCLE_PAY_AUTH_P。
ALIPAY_PERIODIC_PRODUCT_CODE=
# 退款状态未知时由主 Worker 调度 subscriptionService.processPendingRefundReconciliations；
# 该扫描同时处理会员订阅和永久积分包订单。
# 仅用于保护每轮数据库扫描，不会改变 provider 结果；最大值固定为 50。
SUBSCRIPTION_REFUND_RECONCILIATION_LIMIT=50
SUBSCRIPTION_REFUND_RECONCILIATION_ENABLED=false
SUBSCRIPTION_REFUND_RECONCILIATION_INTERVAL_MS=60000
# 支付成功通知丢失时，由独立 Worker 主动查单并关闭超时未付款订单；
# 该扫描同时处理会员订阅和永久积分包订单。
# 迁移 035 和沙箱验收完成前保持 false。
SUBSCRIPTION_PAYMENT_RECONCILIATION_ENABLED=false
SUBSCRIPTION_PAYMENT_RECONCILIATION_INTERVAL_MS=60000
SUBSCRIPTION_PAYMENT_RECONCILIATION_LIMIT=50
SUBSCRIPTION_PAYMENT_RECONCILIATION_MIN_AGE_MS=120000
SUBSCRIPTION_PAYMENT_CLOSE_AFTER_MS=2100000

# ─── SMTP 到期与主动续费提醒 ──────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=StarDraw <no-reply@example.com>
# Comma-separated root/admin recipients for operational alerts.
OPERATIONAL_ALERT_EMAILS=root@example.com,admin@example.com
CREATION_NOTIFICATION_ENABLED=false
CREATION_NOTIFICATION_RETRY_MS=300000
CREATION_NOTIFICATION_BATCH_LIMIT=100
APP_TIMEZONE=Asia/Shanghai

# ─── 安全与日志 ────────────────────────────────────────────────────
# 管理权限仅使用数据库 app_role；项目不支持 API_ADMIN_KEY 或 X-Admin-Key 提权。
# 开启后，Authing 访问令牌必须包含 email 与 email_verified=true（或 Authing 的 emailVerified=true）。
# 先确认 Authing OIDC scope/Token 自定义配置确实返回该 claim，再在生产启用，避免锁住全部账号。
AUTH_REQUIRE_VERIFIED_EMAIL=false
# root/admin 只要求有效登录与数据库角色，不要求 Authing MFA。
# 允许的前端来源（多个用逗号分隔）
ALLOWED_ORIGINS=https://your-domain.com
# 当前公网链路为 Caddy/入口代理 → Web Nginx → API，共信任 2 跳；拓扑变化时必须同步调整。
TRUST_PROXY_HOPS=2

# 日志目录（容器内路径；Compose 分别覆盖为 /app/logs/api 和 /app/logs/worker）
LOG_DIR=/app/logs

# 日志级别：error / warn / info / http / debug
LOG_LEVEL=info

# 工作流媒体节点只查询首次提交的 creationId；默认最多轮询约 60 分钟（每 10 秒一次）。
WORKFLOW_MEDIA_MAX_POLL_ATTEMPTS=360

# 进程崩溃遗留的分阶段上传文件在启动时清理；最小 60000 ms。
UPLOAD_TEMP_MAX_AGE_MS=86400000

# 应用公网地址（用于生成回调 URL 等）
APP_BASE_URL=https://your-domain.com
