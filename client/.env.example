# ─── 身份认证 ─────────────────────────────────────────────────────
# 默认使用 Authing；切换标准 OIDC/Logto 前，先在隔离环境完成 PoC。
VITE_AUTH_PROVIDER=authing

# ─── Authing 鉴权（VITE_AUTH_PROVIDER=authing 时使用）────────────
# 在 Authing 控制台「应用」→「应用配置」中获取
VITE_AUTHING_APP_ID=your_authing_app_id
VITE_AUTHING_DOMAIN=https://your-app.authing.cn

# 登录成功后 Authing 回调到此地址（需要在 Authing 控制台「登录回调 URL」中配置相同地址）
# 开发环境：http://localhost:5173/callback
# 生产环境：https://your-domain.com/callback
VITE_AUTHING_REDIRECT_URI=http://localhost:5173/callback

# 登出后跳转地址（需要在 Authing 控制台「登出回调 URL」中配置）
VITE_AUTHING_LOGOUT_URI=http://localhost:5173/

# ─── 标准 OIDC / Logto（VITE_AUTH_PROVIDER=oidc 或 logto 时使用）─
VITE_OIDC_ISSUER=https://your-oidc.example.com/oidc
VITE_OIDC_CLIENT_ID=your_oidc_client_id
VITE_OIDC_RESOURCE=https://your-api-resource.example.com
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_LOGOUT_URI=http://localhost:5173/
# 可选；默认使用 ${VITE_OIDC_ISSUER}/.well-known/openid-configuration
VITE_OIDC_DISCOVERY_URL=
VITE_OIDC_SCOPES=openid profile email phone identities urn:logto:scope:sessions offline_access

# ─── API 地址 ──────────────────────────────────────────────────────
# 开发环境：http://localhost:5000
# 生产环境：留空（Nginx 反向代理 /api，使用相对路径）
VITE_BASE_URL=http://localhost:5000

# Keep the mixed workflow/storyboard/editor/3D workspace hidden until the
# complete feature set has passed staging acceptance.
VITE_FEATURE_MIXED_CANVAS=false

# Keep the public/private template marketplace hidden until acceptance tests
# for membership gates and template launch flows are complete.
VITE_FEATURE_TEMPLATE_MARKETPLACE=false
VITE_FEATURE_TASK_CENTER=true
