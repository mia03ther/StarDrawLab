FROM all.nxfl.cc/node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm ci --registry=$NPM_REGISTRY --no-audit --no-fund

COPY . .

ARG VITE_AUTHING_APP_ID
ARG VITE_AUTHING_DOMAIN
ARG VITE_AUTHING_REDIRECT_URI
ARG VITE_AUTHING_LOGOUT_URI
ARG VITE_AUTH_PROVIDER=authing
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_RESOURCE
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_LOGOUT_URI
ARG VITE_OIDC_DISCOVERY_URL
ARG VITE_OIDC_SCOPES
ARG VITE_BASE_URL
ARG VITE_RELEASE_VERSION=local
ARG VITE_FEATURE_TASK_CENTER=true
ARG VITE_VIDEO_GENERATION_ENABLED=true

ENV VITE_AUTHING_APP_ID=$VITE_AUTHING_APP_ID
ENV VITE_AUTHING_DOMAIN=$VITE_AUTHING_DOMAIN
ENV VITE_AUTHING_REDIRECT_URI=$VITE_AUTHING_REDIRECT_URI
ENV VITE_AUTHING_LOGOUT_URI=$VITE_AUTHING_LOGOUT_URI
ENV VITE_AUTH_PROVIDER=$VITE_AUTH_PROVIDER
ENV VITE_OIDC_ISSUER=$VITE_OIDC_ISSUER
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_RESOURCE=$VITE_OIDC_RESOURCE
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI
ENV VITE_OIDC_LOGOUT_URI=$VITE_OIDC_LOGOUT_URI
ENV VITE_OIDC_DISCOVERY_URL=$VITE_OIDC_DISCOVERY_URL
ENV VITE_OIDC_SCOPES=$VITE_OIDC_SCOPES
ENV VITE_BASE_URL=$VITE_BASE_URL
ENV VITE_RELEASE_VERSION=$VITE_RELEASE_VERSION
ENV VITE_FEATURE_TASK_CENTER=$VITE_FEATURE_TASK_CENTER
ENV VITE_VIDEO_GENERATION_ENABLED=$VITE_VIDEO_GENERATION_ENABLED

RUN npm run build

# ── 生产：Nginx 托管静态资源 ──────────────────────
FROM all.nxfl.cc/nginx:1.27-alpine AS production
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
